# Mermaid diagram rendering in terminal
render-mermaid() {
  local file="${1:--}"
  local output="/tmp/mermaid-render.png"
  local puppeteer_config="$HOME/.config/mermaid/puppeteer-config.json"

  if [[ "$file" == *.md ]]; then
    mmdc -p "$puppeteer_config" -i "$file" -o "$output" 2>&1 && chafa "$output"
  else
    mmdc -p "$puppeteer_config" -i "$file" -o "$output" 2>&1 && chafa "$output"
  fi
}

